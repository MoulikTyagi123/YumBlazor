@page "/cart"
@using System.Security.Claims
@using YumBlazor.Services
@using YumBlazor.Utility
@inject AuthenticationStateProvider _AuthenticationStateProvider
@inject IShoppingCartRepository _cartRepository
@inject NavigationManager _NavigationManager
@inject IJSRuntime _JS
@inject IOrderRepository _orderRepository
@inject SharedStateService _sharedStateService
@inject PaymentService _paymentService

<h3 class="mb-4">Cart Summary</h3>

@if (CartItems == null)
{
    <p>Loading...</p>
}
else if (!CartItems.Any())
{
    <div class="text-center mt-5">
        <h4>Your cart is empty 🛒</h4>
        <button class="btn btn-primary mt-3" @onclick='() => _NavigationManager.NavigateTo("/")'>Go Shopping</button>
    </div>
}
else
{
    <div class="row">
        @* LEFT: Items List *@
        <div class="col-md-7">
            @foreach (var item in CartItems)
            {
                <div class="card mb-3 shadow-sm p-3">
                    <div class="d-flex align-items-center">
                        <img src="@item.Product.ImageUrl" class="cart-img me-3" style="width:80px; height:80px; object-fit:cover;" onerror="this.src='/images/noimage.png'" />
                        <div class="flex-grow-1">
                            <h6>@item.Product.Name</h6>
                            <small class="text-muted">@((item.Product.Price * item.Count).ToString("C"))</small>
                            <div class="d-flex align-items-center mt-2">
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => UpdateQuantity(item.ProductId, -1)">-</button>
                                <span class="mx-3 fw-bold">@item.Count</span>
                                <button class="btn btn-outline-success btn-sm" @onclick="() => UpdateQuantity(item.ProductId, 1)">+</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* RIGHT: Checkout Form *@
        <div class="col-md-5">
            <EditForm Model="OrderHeader" OnValidSubmit="PlaceOrder">
                <DataAnnotationsValidator />
                <div class="card p-4 shadow-sm">
                    <h5>Pickup Details</h5>
                    <hr />
                    <InputText class="form-control mb-2" placeholder="Name" @bind-Value="OrderHeader.Name" />
                    <InputText class="form-control mb-2" @bind-Value="OrderHeader.Email" readonly />
                    <InputText class="form-control mb-3" placeholder="Phone" @bind-Value="OrderHeader.PhoneNumber" />

                    <div class="d-flex justify-content-between">
                        <h6>Total:</h6>
                        <h5 class="text-success">@GrandTotal.ToString("C")</h5>
                    </div>
                    <button type="submit" class="btn btn-success w-100 mt-3">Pay and Place Order</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<ShoppingCart> CartItems;
    public OrderHeader OrderHeader { get; set; } = new() { Status = "Pending" };
    private double GrandTotal => CartItems?.Sum(x => (double)x.Product.Price * x.Count) ?? 0;

    protected override async Task OnInitializedAsync() => await LoadCart();

    private async Task LoadCart()
    {
        var auth = await _AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        OrderHeader.Email = auth.User.FindFirst(ClaimTypes.Email)?.Value;
        CartItems = (await _cartRepository.GetAllAsync(userId)).ToList();
    }

    private async Task UpdateQuantity(int pId, int c)
    {
        var auth = await _AuthenticationStateProvider.GetAuthenticationStateAsync();
        await _cartRepository.UpdateCartAsync(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, pId, c);
        _sharedStateService.TotalCartCount = await _cartRepository.GetTotalCartCountAsync(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value);
        await LoadCart();
    }

    private async Task PlaceOrder()
    {
        OrderHeader.OrderDate = DateTime.Now;
        OrderHeader.OrderTotal = GrandTotal;
        OrderHeader.OrderDetails = CartItems.Select(i => new OrderDetails
        {
            ProductId = i.ProductId,
            Count = i.Count,
            Price = (double)i.Product.Price,
            ProductName = i.Product.Name
        }).ToList();

        // Create Stripe Session
        var session = _paymentService.CreateStripeCheckoutSession(OrderHeader);
        OrderHeader.SessionId = session.Id;

        // Save Order with Session ID
        await _orderRepository.CreateAsync(OrderHeader);

        // Redirect to Stripe
        _NavigationManager.NavigateTo(session.Url);
    }
}