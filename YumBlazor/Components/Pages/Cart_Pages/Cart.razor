@page "/cart"
@using System.Security.Claims
@using YumBlazor.Services
@using YumBlazor.Utility
@inject AuthenticationStateProvider _AuthenticationStateProvider
@inject IShoppingCartRepository _cartRepository
@inject NavigationManager _NavigationManager
@inject IJSRuntime _JS
@inject IOrderRepository _orderRepository
@inject SharedStateService _sharedStateService
@inject PaymentService _paymentService

<PageTitle>Cart - YumBlazor</PageTitle>

<div class="container-fluid px-2 px-md-4 py-3">
    <h3 class="mb-4 fw-bold">
        <i class="bi bi-cart3 me-2 text-success"></i>Cart Summary
    </h3>

    @if (CartItems == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2 text-muted">Loading your cart...</p>
        </div>
    }
    else if (!CartItems.Any())
    {
        <div class="text-center mt-5 py-5">
            <i class="bi bi-cart-x" style="font-size: 4rem; color: #ccc;"></i>
            <h4 class="mt-3 text-muted">Your cart is empty 🛒</h4>
            <p class="text-muted">Looks like you haven't added anything yet!</p>
            <button class="btn btn-success mt-2 px-4" @onclick='() => _NavigationManager.NavigateTo("/")'>
                <i class="bi bi-arrow-left me-2"></i>Go Shopping
            </button>
        </div>
    }
    else
    {
        <div class="row g-3">

            <!-- LEFT: Cart Items -->
            <div class="col-12 col-lg-7">
                @foreach (var item in CartItems)
                {
                    <div class="card mb-3 shadow-sm border-0" style="border-radius:12px;">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.Product.ImageUrl"
                                     class="rounded"
                                     style="width:70px; height:70px; object-fit:cover; flex-shrink:0;"
                                     onerror="this.src='/images/noimage.png'" />
                                <div class="flex-grow-1 min-width-0">
                                    <h6 class="fw-bold mb-1 text-truncate">@item.Product.Name</h6>
                                    <p class="text-success fw-bold mb-2 fs-6">
                                        @((item.Product.Price * item.Count).ToString("C"))
                                    </p>
                                    <div class="d-flex align-items-center">
                                        <button class="btn btn-outline-danger btn-sm px-2 py-1"
                                                style="width:32px; height:32px; line-height:1;"
                                                @onclick="() => UpdateQuantity(item.ProductId, -1)">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <span class="mx-3 fw-bold fs-6">@item.Count</span>
                                        <button class="btn btn-outline-success btn-sm px-2 py-1"
                                                style="width:32px; height:32px; line-height:1;"
                                                @onclick="() => UpdateQuantity(item.ProductId, 1)">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                        <span class="ms-3 text-muted small">
                                            @item.Product.Price.ToString("C") each
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- RIGHT: Checkout Form -->
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm border-0 sticky-lg-top" style="border-radius:12px; top:80px;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-bag-check me-2 text-success"></i>Pickup Details
                        </h5>
                        <hr />
                        <EditForm Model="OrderHeader" OnValidSubmit="PlaceOrder">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Full Name</label>
                                <InputText class="form-control" placeholder="Enter your name" @bind-Value="OrderHeader.Name" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Email</label>
                                <InputText class="form-control bg-light" @bind-Value="OrderHeader.Email" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Phone Number</label>
                                <InputText class="form-control" placeholder="Enter phone number" @bind-Value="OrderHeader.PhoneNumber" />
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted">Items (@CartItems.Sum(x => x.Count))</span>
                                <span class="fw-bold">@GrandTotal.ToString("C")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fw-bold fs-5">Grand Total</span>
                                <span class="fw-bold fs-5 text-success">@GrandTotal.ToString("C")</span>
                            </div>

                            <button type="submit" class="btn btn-success w-100 py-2 fw-bold" style="border-radius:8px;">
                                <i class="bi bi-credit-card me-2"></i>Pay & Place Order
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@code {
    private List<ShoppingCart> CartItems;
    public OrderHeader OrderHeader { get; set; } = new() { Status = "Pending" };
    private double GrandTotal => CartItems?.Sum(x => (double)x.Product.Price * x.Count) ?? 0;

    protected override async Task OnInitializedAsync() => await LoadCart();

    private async Task LoadCart()
    {
        var auth = await _AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        OrderHeader.Email = auth.User.FindFirst(ClaimTypes.Email)?.Value;
        CartItems = (await _cartRepository.GetAllAsync(userId)).ToList();
    }

    private async Task UpdateQuantity(int pId, int c)
    {
        var auth = await _AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await _cartRepository.UpdateCartAsync(userId, pId, c);
        _sharedStateService.TotalCartCount = await _cartRepository.GetTotalCartCountAsync(userId);
        await LoadCart();
    }

    private async Task PlaceOrder()
    {
        OrderHeader.OrderDate = DateTime.Now;
        OrderHeader.OrderTotal = GrandTotal;
        OrderHeader.OrderDetails = CartItems.Select(i => new OrderDetails
        {
            ProductId = i.ProductId,
            Count = i.Count,
            Price = (double)i.Product.Price,
            ProductName = i.Product.Name
        }).ToList();

        var session = _paymentService.CreateStripeCheckoutSession(OrderHeader);
        OrderHeader.SessionId = session.Id;

        await _orderRepository.CreateAsync(OrderHeader);

        _NavigationManager.NavigateTo(session.Url);
    }
}
