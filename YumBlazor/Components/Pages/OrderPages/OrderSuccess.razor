@page "/order/success/{session_id}"
@using YumBlazor.Utility
@inject NavigationManager nav
@inject PaymentService _paymentService
@inject IShoppingCartRepository _shoppingCartRepository
@inject AuthenticationStateProvider _AuthenticationStateProvider

<div class="container text-center mt-5">
    @if (orderHeader == null)
    {
        <p>Confirming your payment...</p>
    }
    else
    {
        <div class="p-5 shadow rounded bg-white">
            <img src="https://cdn-icons-png.flaticon.com/512/148/148767.png" width="120" />
            <h2 class="text-success mt-4 fw-bold">Order Placed Successfully! 🎉</h2>
            <h5 class="mt-3">Your Order Id: <span class="badge bg-success">#@orderHeader.Id</span></h5>
            <p class="text-muted mt-3">Payment confirmed. Thank you for ordering! ❤️</p>

            <div class="mt-4">
                <button class="btn btn-success btn-lg px-5" @onclick='() => nav.NavigateTo($"/order/details/{orderHeader.Id}")'>
                    View Order
                </button>
                <button class="btn btn-outline-secondary btn-lg px-5 ms-2" @onclick='() => nav.NavigateTo("/")'>
                    Home
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string session_id { get; set; }
    private OrderHeader orderHeader;

    protected override async Task OnInitializedAsync()
    {
        orderHeader = await _paymentService.CheckPaymentStatusAndUpdateOrder(session_id);

        if (orderHeader != null && orderHeader.Status == SD.StatusApproved)
        {
            var auth = await _AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            await _shoppingCartRepository.ClearCartAsync(userId);
        }
    }
}