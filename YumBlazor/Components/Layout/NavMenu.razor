@using Microsoft.AspNetCore.Components.Authorization
@using YumBlazor.Services
@implements IDisposable
@inject SharedStateService _sharedStateService
@inject IShoppingCartRepository _shoppingCartRepository
@inject AuthenticationStateProvider _authStateProvider

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container-fluid px-3">

        <!-- Brand -->
        <NavLink class="navbar-brand fw-bold fs-5" href="/">🍔 YumBlazor</NavLink>

        <!-- Cart Badge (Mobile pe hamesha dikhega) -->
        <NavLink href="/cart" class="btn btn-outline-light btn-sm d-lg-none me-2">
            <i class="bi bi-cart3"></i> @_sharedStateService.TotalCartCount
        </NavLink>

        <!-- Hamburger Button -->
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Collapsible Menu -->
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">
                        <i class="bi bi-house me-1"></i>Home
                    </NavLink>
                </li>
                <li class="nav-item d-none d-lg-block">
                    <NavLink href="/cart" class="nav-link" Match="NavLinkMatch.All">
                        <i class="bi bi-cart3 me-1"></i>Cart (@_sharedStateService.TotalCartCount)
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink href="/order/list" class="nav-link" Match="NavLinkMatch.All">
                        <i class="bi bi-list-ul me-1"></i>Order List
                    </NavLink>
                </li>
            </ul>

            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-2 pb-2 pb-lg-0">
                <AuthorizeView>
                    <Authorized Context="auth">
                        <span class="text-light small">
                            <i class="bi bi-person-circle me-1"></i>@auth.User.Identity?.Name
                        </span>
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="Account/Register" class="btn btn-outline-light btn-sm">Register</NavLink>
                        <NavLink href="Account/Login" class="btn btn-success btn-sm">Login</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        _sharedStateService.OnChange += OnSharedStateChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetInitialCount();
        }
    }

    private void OnSharedStateChange() => InvokeAsync(StateHasChanged);

    public async Task GetInitialCount()
    {
        try
        {
            await Task.Delay(500);
            var authState = await _authStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
                _sharedStateService.TotalCartCount = await _shoppingCartRepository.GetTotalCartCountAsync(userId);
                StateHasChanged();
            }
        }
        catch (Exception) { }
    }

    public void Dispose() => _sharedStateService.OnChange -= OnSharedStateChange;
}