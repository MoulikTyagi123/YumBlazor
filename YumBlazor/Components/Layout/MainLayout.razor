@inherits LayoutComponentBase
@using YumBlazor.Utility

<div class="page">

    <!-- ADMIN SIDEBAR ONLY -->
    <AuthorizeView Roles="@SD.Role_Admin">
        <div class="sidebar">
            <NavMenu />
        </div>
    </AuthorizeView>

    <main>

        <!-- ALWAYS SHOW NAVBAR -->
        <NavBar />

        <!-- PAGE CONTENT -->
        <article class="content px-4">
            @Body
        </article>

    </main>
</div>
