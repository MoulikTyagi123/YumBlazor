<div class="modal fade" id="bsConfirmationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">@Title</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <button type="button"
                        class="btn btn-lg btn-secondary me-2"
                        data-bs-dismiss="modal"
                        style="width:150px;">
                    Close
                </button>

                <button type="button"
                        class="btn btn-lg @ButtonBootstrapStyle"
                        @onclick="() => ConfirmationClicked(true)"
                        style="width:150px;">
                    @ButtonText
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<bool> OnModalConfirmation { get; set; }

    [Parameter]
    public string Title { get; set; } = "Please Confirm";

    [Parameter]
    public string ButtonBootstrapStyle { get; set; } = "btn-primary";

    [Parameter]
    public string ButtonText { get; set; } = "Confirm";

    private async Task ConfirmationClicked(bool value)
    {
        await OnModalConfirmation.InvokeAsync(value);
    }
}
